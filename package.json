{
  "name": "family-geneology",
  "version": "0.3.0",
  "description": "Genealogy family tree desktop app",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/electron-vite.mjs preview",
    "postinstall": "electron-builder install-app-deps && node node_modules/electron/install.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:mac": "npm run build && electron-builder --mac --config",
    "build:win": "npm run build && electron-builder --win --config",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@xyflow/react": "12.11.3",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "electron-store": "8.2.0",
    "elkjs": "0.10.2",
    "i18next": "25.10.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "15.7.4",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "uuid": "11.1.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/uuid": "10.0.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "0.31.10",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.11.0",
    "happy-dom": "20.0.2",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@electron/asar": "4.3.0",
    "@electron/get": "5.0.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.5"
    },
    "esbuild": "0.25.5",
    "glob": "13.0.6",
    "rimraf": "6.0.1"
  },
  "build": {
    "appId": "com.family.genealogy",
    "productName": "Family Genealogy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "fgtree",
        "name": "Family Genealogy Tree",
        "description": "Family genealogy project archive",
        "role": "Editor",
        "icon": "build/icon"
      }
    ]
  }
}
